# SMARTFINANCE AI — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env.production on production host

# Server & Network Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://app.smartfinance.ai

# Persistent Storage & Database
MONGODB_URI=mongodb://mongodb:27017/smartfinance
FILE_STORAGE_PATH=/app/uploads
MAX_FILE_SIZE=25000000

# Authentication & Cryptographic Secrets (GENERATE UNIQUE RANDOM KEYS FOR PROD)
JWT_SECRET=replace_with_64_character_random_hex_string_for_production
JWT_REFRESH_SECRET=replace_with_another_64_character_random_hex_string
VAULT_ENCRYPTION_KEY=replace_with_32_byte_hex_key_for_aes_256_gcm_vault_encryption

# Microservices Communication
PYTHON_SERVICE_URL=http://python-engine:8000
PYTHON_SERVICE_SECRET=replace_with_internal_microservice_shared_secret

# AI Providers & Integrations (Optional)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_production_google_gemini_api_key
OPENAI_API_KEY=your_production_openai_api_key
