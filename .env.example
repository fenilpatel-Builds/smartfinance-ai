# =================================================================
# SMARTFINANCE AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =================================================================
# Copy this file to .env or create corresponding .env in server/ and python-service/

# -----------------------------------------------------------------
# 1. NODE.JS BACKEND SERVER CONFIGURATION (server/.env)
# -----------------------------------------------------------------
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Must be a persistent replica set or standalone DB)
# In Docker Compose: mongodb://mongodb:27017/smartfinance
# Locally: mongodb://localhost:27017/smartfinance
MONGODB_URI=mongodb://localhost:27017/smartfinance

# Cryptographic Keys (Generate 32-character random strings in production)
JWT_SECRET=replace_with_a_cryptographically_secure_random_jwt_secret_key_32_chars_min
JWT_REFRESH_SECRET=replace_with_a_cryptographically_secure_random_refresh_secret_key
VAULT_ENCRYPTION_KEY=replace_with_aes_256_gcm_passphrase_for_document_vault_encryption

# Frontend Client URL (Used for CORS validation)
CLIENT_URL=http://localhost:5173

# Python Processing Microservice Bridge
PYTHON_SERVICE_URL=http://localhost:8000
PYTHON_SERVICE_SECRET=replace_with_shared_internal_microservice_auth_secret_key

# Artificial Intelligence Providers (Optional - deterministic fallback activates if omitted)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# File Storage Configuration
FILE_STORAGE_PATH=./uploads
MAX_FILE_SIZE=26214400

# -----------------------------------------------------------------
# 2. PYTHON FASTAPI PROCESSING SERVICE (python-service/.env)
# -----------------------------------------------------------------
PYTHON_ENV=production
PORT=8000
HOST=0.0.0.0
SERVICE_SECRET=replace_with_shared_internal_microservice_auth_secret_key
MAX_FILE_SIZE=26214400
PROCESSING_TIMEOUT=60
OCR_LANGUAGE=eng

# System Binary Paths (leave blank if installed in standard PATH)
# Windows Example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux Example: /usr/bin/tesseract
TESSERACT_CMD=

# -----------------------------------------------------------------
# 3. REACT VITE FRONTEND (client/.env)
# -----------------------------------------------------------------
VITE_API_BASE_URL=/api

